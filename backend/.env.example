# For a host-run backend with docker-compose.dev.yml dependencies.
# Export these variables in your shell; Go does not load dotenv files.
PORT=8080
# Keep false unless a trusted reverse proxy overwrites X-Real-IP.
TRUST_PROXY_HEADERS=false
DATABASE_URL=postgres://roadmates:replace-with-local-postgres-password@localhost:5432/roadmates?sslmode=disable
REDIS_URL=redis://:replace-with-local-redis-password@localhost:6379/0
MIN_SUPPORTED_APP_VERSION=0.0.0
LOG_LEVEL=info
API_V1_DEPRECATED=false
API_V1_DEPRECATION_DATE=
API_V1_SUNSET_DATE=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use the root .env's key when connecting to the same database.
PII_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
