# Copy to .env; replace placeholders. Do not commit .env.
# Use URL-safe database/Redis passwords, or percent-encode them in the URLs.
POSTGRES_USER=roadmates
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=roadmates
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# Browser-facing Docker port. PORT is the backend's internal container port.
WEB_PORT=8081
PORT=8080

# Release commands derive APP_VERSION from VERSION and override this fallback.
APP_VERSION=0.1.0
MIN_SUPPORTED_APP_VERSION=0.0.0
LOG_LEVEL=info
API_V1_DEPRECATED=false
API_V1_DEPRECATION_DATE=
API_V1_SUNSET_DATE=

# Auth settings. Generate a JWT secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:${WEB_PORT}
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional first-start admin: set both above. Existing accounts are not promoted.
# ADMIN_PASSWORD must follow the same password policy as registration.
# Required: base64 of exactly 32 random bytes. Keep stable for existing data.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
